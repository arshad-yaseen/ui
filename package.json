{
  "name": "ui",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint",
    "format": "oxfmt",
    "generate": "turbo run generate",
    "screenshot": "bun run --cwd packages/ui screenshot"
  },
  "devDependencies": {
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "turbo": "^2.11.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4"
    }
  }
}
