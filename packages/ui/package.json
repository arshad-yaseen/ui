{
  "name": "@arshad/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./styles.css": "./src/styles/globals.css",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./config/*": "./src/config/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "bun scripts/generate-loaders.ts && oxfmt src/components/dot-matrix"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "next-themes": "^0.4.6",
    "sugar-high": "^2.4.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@arshad/typescript-config": "workspace:*",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
