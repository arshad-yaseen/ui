{
  "name": "@arshad/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./styles.css": "./src/styles/globals.css",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./config/*": "./src/config/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "bun scripts/generate-loaders.ts && oxfmt src/components/dot-matrix",
    "screenshot": "bun scripts/screenshot.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "next-themes": "^0.4.6",
    "sugar-high": "^2.6.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@arshad/typescript-config": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "next": "16.4.3",
    "playwright": "^1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
